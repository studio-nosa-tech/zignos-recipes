#!/bin/sh
# flex — lexical analyzer generator (LFS 13.1-systemd 8.16).
set -e

cd "$ZPKG_SRC/flex-2.6.17"
./configure --prefix=/usr    \
            --disable-static \
            --docdir=/usr/share/doc/flex-2.6.17
make
make DESTDIR="$ZPKG_DESTROOT" install
ln -sv flex "$ZPKG_DESTROOT/usr/bin/lex"
ln -sv flex.1 "$ZPKG_DESTROOT/usr/share/man/man1/lex.1"
