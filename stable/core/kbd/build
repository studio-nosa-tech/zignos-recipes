#!/bin/sh
# kbd — console keymap/font tools for the OpenRC keymaps service
# (LFS 13.1-systemd 8.68; the backspace patch and vlock are skipped in v0).
set -e

cd "$ZPKG_SRC/kbd-2.10.0"
sed -i '/RESIZECONS_PROGS=/s/yes/no/' configure
sed -i 's/resizecons.8 //' docs/man/man8/Makefile.in
./configure --prefix=/usr --disable-vlock
make -j"$(nproc)"
make DESTDIR="$ZPKG_DESTROOT" install
