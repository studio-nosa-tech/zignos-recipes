#!/bin/sh
# mpfr — multiple precision floating point (LFS 13.1-systemd 8.24).
set -e

cd "$ZPKG_SRC/mpfr-4.2.2"
./configure --prefix=/usr        \
            --disable-static     \
            --enable-thread-safe \
            --docdir=/usr/share/doc/mpfr-4.2.2
make
make DESTDIR="$ZPKG_DESTROOT" install
