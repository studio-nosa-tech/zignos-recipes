#!/bin/sh
# bubblewrap — unprivileged namespace sandbox used by "zpkg build" to
# isolate recipe build scripts. SELinux and man pages are disabled; libcap
# is required for capability handling.
set -e

cd "$ZPKG_SRC/bubblewrap-0.13.1"
meson setup build \
    --prefix=/usr \
    --libdir=lib \
    --buildtype=release \
    -Dman=disabled \
    -Dselinux=disabled \
    -Dtests=false \
    -Dbash_completion=disabled \
    -Dzsh_completion=disabled
meson compile -C build
DESTDIR="$ZPKG_DESTROOT" meson install -C build --no-rebuild
