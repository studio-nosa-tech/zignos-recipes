#!/bin/sh
# zignos-fstab — write /etc/fstab from the live mount table.
#
#   zignos-fstab [TARGET]
#
# TARGET is the mountpoint of the target root (default /). Preparing a
# stage3 install from a rescue system:
#
#   /mnt/zignos/usr/sbin/zignos-fstab /mnt/zignos
#
# Repairing a system that booted read-only because /etc/fstab pointed at
# the wrong UUID or device:
#
#   mount -o remount,rw "$(findmnt -no SOURCE /)" /
#   zignos-fstab /
#
# The root device is resolved from the mount table, not from the existing
# fstab, so this works even when the old fstab is wrong.
set -e

target=${1:-/}
[ -d "$target" ] || { echo "zignos-fstab: $target is not a directory" >&2; exit 1; }
target=$(readlink -f "$target")

src=$(findmnt -no SOURCE --target "$target")
[ -n "$src" ] || { echo "zignos-fstab: cannot resolve the device for $target" >&2; exit 1; }

uuid=$(blkid -s UUID -o value "$src" 2>/dev/null || true)
[ -n "$uuid" ] || { echo "zignos-fstab: no filesystem UUID on $src" >&2; exit 1; }
fstype=$(findmnt -no FSTYPE --target "$target")

fstab="$target/etc/fstab"
tmp="$fstab.zignos-fstab.$$"
trap 'rm -f "$tmp"' EXIT INT TERM

{
	echo "# Generated by zignos-fstab. Root is identified by filesystem UUID."
	echo "UUID=$uuid / $fstype defaults 0 0"
	esp=$(findmnt -no SOURCE,FSTYPE --mountpoint "$target/boot/efi" 2>/dev/null || true)
	if [ -n "$esp" ]; then
		esp_src=${esp%% *}
		esp_type=${esp##* }
		esp_uuid=$(blkid -s UUID -o value "$esp_src" 2>/dev/null || true)
		if [ -n "$esp_uuid" ]; then
			echo "UUID=$esp_uuid /boot/efi $esp_type defaults 0 0"
		fi
	fi
	echo "proc  /proc proc  defaults 0 0"
	echo "sysfs /sys  sysfs defaults 0 0"
} > "$tmp"

if [ -f "$fstab" ]; then
	cp -a "$fstab" "$fstab.bak"
fi
mv -f "$tmp" "$fstab"

echo "zignos-fstab: wrote $fstab"
cat "$fstab"
