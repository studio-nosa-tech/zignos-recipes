#!/bin/sh
# fonts-noto-cjk — Noto Sans CJK and Noto Serif CJK TTCs.
set -e

cd "$ZPKG_SRC"
rm -rf sans serif
# The release assets carry 00_/01_ prefixes; the archives themselves
# contain NotoSansCJK.ttc (plus LICENSE) and NotoSerifCJK.ttc.
unzip -q 00_NotoSansCJK.ttc.zip -d sans
unzip -q 01_NotoSerifCJK.ttc.zip -d serif
install -d "$ZPKG_DESTROOT/usr/share/fonts/noto-cjk"
install -m644 sans/NotoSansCJK.ttc serif/NotoSerifCJK.ttc "$ZPKG_DESTROOT/usr/share/fonts/noto-cjk/"
install -Dm644 sans/LICENSE "$ZPKG_DESTROOT/usr/share/licenses/fonts-noto-cjk/LICENSE"
