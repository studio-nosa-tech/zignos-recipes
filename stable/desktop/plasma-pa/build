#!/bin/sh
# plasma-pa — volume applet and KCM. Talks to PipeWire's PulseAudio server
# through libpulse/pulseaudio-qt; event sounds use libcanberra's pulse backend.
set -e

cd "$ZPKG_SRC/plasma-pa-$ZPKG_VERSION"
cmake -S . -B build -G Ninja \
	-DCMAKE_INSTALL_PREFIX=/usr \
	-DCMAKE_INSTALL_LIBDIR=lib \
	-DCMAKE_BUILD_TYPE=Release \
	-DBUILD_DOC=OFF \
	-DBUILD_TESTING=OFF
cmake --build build
DESTDIR="$ZPKG_DESTROOT" cmake --install build
