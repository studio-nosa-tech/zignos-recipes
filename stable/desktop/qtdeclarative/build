#!/bin/sh
# Qt Declarative — QML, Qt Quick and the qml runtime. The M43 completion
# check runs a QML sample with the offscreen QPA plugin. CMake-only module.
set -e

cd "$ZPKG_SRC/qtdeclarative-everywhere-src-6.8.5"
cmake -S . -B build -G Ninja \
	-DCMAKE_INSTALL_PREFIX=/usr \
	-DCMAKE_INSTALL_LIBDIR=lib \
	-DCMAKE_BUILD_TYPE=Release \
	-DQT_BUILD_TESTS=OFF \
	-DQT_BUILD_EXAMPLES=OFF
cmake --build build
DESTDIR="$ZPKG_DESTROOT" cmake --install build
