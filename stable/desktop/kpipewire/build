#!/bin/sh
# KDE Plasma 6.4.6 component (stable channel).
set -e

cd "$ZPKG_SRC/kpipewire-6.4.6"
# FFmpeg 8 dropped the FF_PROFILE_* aliases; use the AV_PROFILE_* names.
sed -i 's/\bFF_PROFILE_/AV_PROFILE_/g' src/*.cpp
cmake -S . -B build -G Ninja \
	-DCMAKE_INSTALL_PREFIX=/usr \
	-DCMAKE_INSTALL_LIBDIR=lib \
	-DCMAKE_BUILD_TYPE=Release \
	-DBUILD_TESTING=OFF \
	-DBUILD_HTML_DOCS=OFF \
	-DBUILD_MAN_DOCS=OFF \
	-DBUILD_PYTHON_BINDINGS=OFF \
	-DBUILD_QTHELP_DOCS=OFF
cmake --build build
DESTDIR="$ZPKG_DESTROOT" cmake --install build
