#!/bin/sh
# KWalletManager — wallet management UI (KDE Gear 25.04.3). The handbook
# needs KF6DocTools, so BUILD_DOC is off.
set -e

cd "$ZPKG_SRC/kwalletmanager-$ZPKG_VERSION"
cmake -S . -B build -G Ninja \
	-DCMAKE_INSTALL_PREFIX=/usr \
	-DCMAKE_INSTALL_LIBDIR=lib \
	-DCMAKE_BUILD_TYPE=Release \
	-DBUILD_TESTING=OFF \
	-DBUILD_DOC=OFF
cmake --build build
DESTDIR="$ZPKG_DESTROOT" cmake --install build
