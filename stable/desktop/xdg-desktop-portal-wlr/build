#!/bin/sh
# xdg-desktop-portal-wlr — Screenshot and ScreenCast portal backend for
# wlroots compositors (used by Tessa). ZIGNOS has no systemd, so use
# libelogind's sd-bus and skip the systemd user unit and scdoc man page.
set -e

cd "$ZPKG_SRC/xdg-desktop-portal-wlr-$ZPKG_VERSION"
meson setup build \
	--prefix=/usr --libdir=lib --buildtype=release \
	-Dwerror=false \
	-Dsystemd=disabled \
	-Dman-pages=disabled \
	-Dsd-bus-provider=libelogind
ninja -C build
DESTDIR="$ZPKG_DESTROOT" ninja -C build install

install -Dm644 LICENSE "$ZPKG_DESTROOT/usr/share/licenses/xdg-desktop-portal-wlr/LICENSE"
