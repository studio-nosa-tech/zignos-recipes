#!/bin/sh
# KDE Plasma 6.4.5 component (stable channel).
set -e

cd "$ZPKG_SRC/kscreenlocker-6.4.5"
# KF6Screen's DPMS target links Qt6::WaylandClient; make the imported target
# available before including KF6ScreenConfig.cmake.
python3 - <<'PY'
from pathlib import Path
p = Path("CMakeLists.txt")
s = p.read_text()
if "COMPONENTS WaylandClient" not in s:
    s = s.replace("find_package(KF6Screen REQUIRED)",
                  "find_package(Qt6 COMPONENTS WaylandClient REQUIRED)\nfind_package(KF6Screen REQUIRED)")
    p.write_text(s)
PY
cmake -S . -B build -G Ninja \
	-DCMAKE_INSTALL_PREFIX=/usr \
	-DCMAKE_INSTALL_LIBDIR=lib \
	-DCMAKE_BUILD_TYPE=Release \
	-DBUILD_TESTING=OFF \
	-DBUILD_HTML_DOCS=OFF \
	-DBUILD_MAN_DOCS=OFF \
	-DBUILD_PYTHON_BINDINGS=OFF \
	-DBUILD_QTHELP_DOCS=OFF
cmake --build build
DESTDIR="$ZPKG_DESTROOT" cmake --install build
