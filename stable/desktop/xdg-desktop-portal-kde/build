#!/bin/sh
# xdg-desktop-portal-kde — Plasma backend for xdg-desktop-portal.
set -e

cd "$ZPKG_SRC/xdg-desktop-portal-kde-$ZPKG_VERSION"
cmake -S . -B build -G Ninja \
	-DCMAKE_INSTALL_PREFIX=/usr \
	-DCMAKE_INSTALL_LIBDIR=lib \
	-DCMAKE_BUILD_TYPE=Release \
	-DBUILD_TESTING=OFF \
	-DBUILD_HTML_DOCS=OFF \
	-DBUILD_MAN_DOCS=OFF
cmake --build build
DESTDIR="$ZPKG_DESTROOT" cmake --install build
