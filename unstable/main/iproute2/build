#!/bin/sh
# iproute2 — ip/ss/tc/etc. arpd is not part of the default build target
# (it would need Berkeley DB), so plain make is enough.
#
# ZIGNOS is usr-merged: install sbin programs under /usr/sbin instead of
# upstream's /sbin default.
set -e

cd "$ZPKG_SRC/iproute2-6.19.0"
make -j"$(nproc)" SBINDIR=/usr/sbin
make DESTDIR="$ZPKG_DESTROOT" SBINDIR=/usr/sbin install
