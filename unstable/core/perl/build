#!/bin/sh
# perl — required by openssl's Configure and many build systems. Paths use
# major.minor so they match the existing /usr/lib/perl5/5.44 layout.
set -e

cd "$ZPKG_SRC/perl-$ZPKG_VERSION"
majmin=$(printf '%s' "$ZPKG_VERSION" | cut -d. -f1-2)
# The build root has no man(1), so Configure would pick man1dir/man3dir
# "none" and man*ext 0. With DESTDIR, installman then writes <module>.0
# files directly into the destination root. Pin the standard man paths.
sh Configure -des -D prefix=/usr -D vendorprefix=/usr -D useshrplib \
	-D "privlib=/usr/lib/perl5/$majmin/core_perl" \
	-D "archlib=/usr/lib/perl5/$majmin/core_perl" \
	-D "sitelib=/usr/lib/perl5/$majmin/site_perl" \
	-D "sitearch=/usr/lib/perl5/$majmin/site_perl" \
	-D "vendorlib=/usr/lib/perl5/$majmin/vendor_perl" \
	-D "vendorarch=/usr/lib/perl5/$majmin/vendor_perl" \
	-D man1dir=/usr/share/man/man1 -D man1ext=1 \
	-D man3dir=/usr/share/man/man3 -D man3ext=3pm
make
make DESTDIR="$ZPKG_DESTROOT" install
