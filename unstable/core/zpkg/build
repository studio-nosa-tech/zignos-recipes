#!/bin/sh
# zpkg — the package manager itself. The source archive is shipped in this
# recipe directory so a normal upgrade never depends on the bootstrap-only
# /sources/zignos-zpkg mount. Bootstrap roots that build a working tree
# without a packaged archive can still use /sources as a fallback.
set -e

rm -rf "$ZPKG_WORKDIR/zpkg-src" "$ZPKG_WORKDIR/zignos-zpkg-$ZPKG_VERSION"
archive="$ZPKG_RECIPE_DIR/zignos-zpkg-$ZPKG_VERSION.tar.xz"
if [ -f "$archive" ]; then
	tar -C "$ZPKG_WORKDIR" -xf "$archive"
	mv "$ZPKG_WORKDIR/zignos-zpkg-$ZPKG_VERSION" "$ZPKG_WORKDIR/zpkg-src"
elif [ -d /sources/zignos-zpkg ]; then
	cp -a /sources/zignos-zpkg "$ZPKG_WORKDIR/zpkg-src"
else
	echo "zpkg: missing $archive and /sources/zignos-zpkg" >&2
	exit 1
fi
cd "$ZPKG_WORKDIR/zpkg-src"
# The bootstrap Go is a trimmed build: /usr/bin/go does not know its GOROOT
# unless the environment provides it (the bootstrap exports it; a plain
# chroot does not).
export GOROOT="${GOROOT:-/usr/local/go}"
GOTOOLCHAIN=local go build -trimpath -buildvcs=false -o "$ZPKG_DESTROOT/usr/bin/zpkg" ./cmd/zpkg
