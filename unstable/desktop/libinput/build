#!/bin/sh
set -e
cd "$ZPKG_SRC/libinput-1.32.0"
meson setup build --prefix=/usr --libdir=lib --buildtype=release 	-Dlibwacom=false -Dmtdev=true -Ddebug-gui=false 	-Dtests=false -Dinstall-tests=false -Ddocumentation=false 	-Dlua-plugins=disabled
ninja -C build
DESTDIR="$ZPKG_DESTROOT" meson install -C build
