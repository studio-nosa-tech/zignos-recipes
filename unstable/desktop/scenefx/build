#!/bin/sh
# scenefx 0.5 — wlroots scene API with blur, shadows and rounded corners.
# Tessa uses it for its window effects.
set -e

cd "$ZPKG_SRC/scenefx-$ZPKG_VERSION"
meson setup build \
	--prefix=/usr --libdir=lib --buildtype=release \
	-Dwerror=false \
	-Dexamples=false \
	-Drenderers=gles2 \
	-Dcolor-management=disabled \
	-Dtracy_enable=false
ninja -C build
DESTDIR="$ZPKG_DESTROOT" ninja -C build install
