#!/bin/sh
# fcitx5 — input method framework (Wayland + XIM for Xwayland apps).
set -e

cd "$ZPKG_SRC/fcitx5-5.1.23"
cmake -S . -B build -G Ninja 	-DCMAKE_INSTALL_PREFIX=/usr 	-DCMAKE_INSTALL_LIBDIR=lib 	-DCMAKE_BUILD_TYPE=Release 	-DENABLE_X11=ON 	-DENABLE_WAYLAND=ON 	-DENABLE_ENCHANT=OFF 	-DENABLE_TEST=OFF 	-DENABLE_TESTING_ADDONS=OFF 	-DENABLE_DOC=OFF 	-DUSE_SYSTEMD=OFF 	-DENABLE_LIBUUID=ON 	-DBUILD_SPELL_DICT=OFF 	-DUSE_SYSTEM_PLASMA_WAYLAND_PROTOCOLS=ON
cmake --build build
DESTDIR="$ZPKG_DESTROOT" cmake --install build
