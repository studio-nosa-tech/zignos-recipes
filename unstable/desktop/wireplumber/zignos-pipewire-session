#!/bin/sh
# Start PipeWire, its PulseAudio-compatible server, and WirePlumber for a
# Plasma Wayland session. On OpenRC there are no systemd user units, so
# Plasma's XDG autostart launches this. Safe to run more than once: only
# missing processes are started and existing ones are left alone.
set -e

uid=$(id -u)

if ! pgrep -u "$uid" -x pipewire >/dev/null 2>&1; then
	pipewire &
	pw_pid=$!
	started_pw=1
fi

# plasma-pa and libcanberra talk PulseAudio; pipewire-pulse is the server.
if ! pgrep -u "$uid" -x pipewire-pulse >/dev/null 2>&1; then
	pipewire-pulse &
	pulse_pid=$!
	started_pulse=1
fi

# A second autostart invocation has nothing left to supervise.
if pgrep -u "$uid" -x wireplumber >/dev/null 2>&1; then
	exit 0
fi

wireplumber
rc=$?

if [ "${started_pulse:-0}" = 1 ]; then
	kill "$pulse_pid" 2>/dev/null || true
fi
if [ "${started_pw:-0}" = 1 ]; then
	kill "$pw_pid" 2>/dev/null || true
fi
exit "$rc"
