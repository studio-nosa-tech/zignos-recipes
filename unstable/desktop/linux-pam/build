#!/bin/sh
# Linux-PAM — Pluggable Authentication Modules. Meson build; optional
# audit/SELinux/NIS/econf/pwaccess support is disabled because those
# libraries are not part of the base system.
set -e

cd "$ZPKG_SRC/Linux-PAM-1.7.3"
meson setup build 	--prefix=/usr --libdir=lib --sysconfdir=/etc 	--buildtype=release 	-Ddocs=disabled -Di18n=disabled 	-Daudit=disabled -Dselinux=disabled -Deconf=disabled 	-Dpwaccess=disabled -Dnis=disabled 	-Dlogind=disabled -Delogind=disabled 	-Dpam_userdb=disabled -Dexamples=false -Dxtests=false 	-Dsecuredir=/usr/lib/security -Dsconfigdir=/etc/security
ninja -C build
DESTDIR="$ZPKG_DESTROOT" meson install -C build

# Minimal distro PAM stack used by polkit and, later, the display manager.
install -Dm644 "$ZPKG_RECIPE_DIR/pam.d/system-auth" 	"$ZPKG_DESTROOT/etc/pam.d/system-auth"
