#!/bin/sh
# powerdevil — power management daemon and KCM. Uses UPower over D-Bus and
# libkscreen; DDCutil monitor control is optional and disabled here.
set -e

cd "$ZPKG_SRC/powerdevil-$ZPKG_VERSION"
cmake -S . -B build -G Ninja \
	-DCMAKE_INSTALL_PREFIX=/usr \
	-DCMAKE_INSTALL_LIBDIR=lib \
	-DCMAKE_BUILD_TYPE=Release \
	-DCMAKE_DISABLE_FIND_PACKAGE_DDCUtil=ON \
	-DCMAKE_DISABLE_FIND_PACKAGE_KF6DocTools=ON \
	-DBUILD_TESTING=OFF \
	-DBUILD_HTML_DOCS=OFF \
	-DBUILD_MAN_DOCS=OFF \
	-DBUILD_QTHELP_DOCS=OFF
cmake --build build
DESTDIR="$ZPKG_DESTROOT" cmake --install build
