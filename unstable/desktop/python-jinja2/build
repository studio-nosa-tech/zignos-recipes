#!/bin/sh
# Jinja2 — template engine. elogind's Meson build uses it to render
# logind.conf and D-Bus service files.
set -e

cd "$ZPKG_SRC/jinja2-3.1.6"
purelib=$(python3 -c 'import sysconfig; print(sysconfig.get_path("purelib"))')
install -d "$ZPKG_DESTROOT$purelib"
cp -a src/jinja2 "$ZPKG_DESTROOT$purelib/"
install -Dm644 LICENSE.txt "$ZPKG_DESTROOT/usr/share/licenses/jinja2/LICENSE.txt"
