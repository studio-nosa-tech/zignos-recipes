#!/bin/sh
# MarkupSafe — Python string escaping used by Jinja2. Installed as the
# pure-Python module; the optional C speedup is not required by elogind's
# build-time Jinja2.
set -e

cd "$ZPKG_SRC/markupsafe-3.0.4"
purelib=$(python3 -c 'import sysconfig; print(sysconfig.get_path("purelib"))')
install -d "$ZPKG_DESTROOT$purelib"
cp -a src/markupsafe "$ZPKG_DESTROOT$purelib/"
install -Dm644 LICENSE.txt "$ZPKG_DESTROOT/usr/share/licenses/markupsafe/LICENSE.txt"
