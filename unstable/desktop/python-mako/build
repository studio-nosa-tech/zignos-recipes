#!/bin/sh
# Mako — template library. Mesa imports it at build time to generate
# shader and dispatch sources.
set -e

cd "$ZPKG_SRC/mako-1.4.3"
purelib=$(python3 -c 'import sysconfig; print(sysconfig.get_path("purelib"))')
install -d "$ZPKG_DESTROOT$purelib"
cp -a mako "$ZPKG_DESTROOT$purelib/"
install -Dm644 LICENSE "$ZPKG_DESTROOT/usr/share/licenses/mako/LICENSE"
