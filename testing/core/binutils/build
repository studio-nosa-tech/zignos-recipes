#!/bin/sh
# binutils — assembler, linker, binary utilities (LFS 13.1-systemd 8.22,
# tests skipped in v0: they need tcl/expect/dejagnu).
set -e

cd "$ZPKG_SRC/binutils-2.47"
mkdir -v build
cd build
../configure --prefix=/usr       \
             --sysconfdir=/etc   \
             --enable-ld=default \
             --enable-plugins    \
             --enable-shared     \
             --disable-werror    \
             --enable-64-bit-bfd \
             --enable-new-dtags  \
             --with-system-zlib  \
             --with-lib-path=/usr/lib \
             --enable-default-hash-style=gnu
make tooldir=/usr
make tooldir=/usr DESTDIR="$ZPKG_DESTROOT" install
for lib in bfd ctf ctf-nobfd gprofng opcodes sframe; do
	rm -fv "$ZPKG_DESTROOT/usr/lib/lib$lib.a"
done
rm -rfv "$ZPKG_DESTROOT/usr/share/doc/gprofng"
