#!/bin/sh
# gcc — the GNU compiler collection (LFS 13.1-systemd 8.32, tests skipped
# in v0: they need the tester user + expect/dejagnu).
set -e

cd "$ZPKG_SRC/gcc-16.2.0"
# The temp-system gawk (built without mpfr) trips a gawk 5.4.1 regression
# that mangles GCC's awk-generated option tables (unconditional #error in
# options.cc). The bootstrap places mawk in the chroot for this; mawk is
# also what AC_PROG_AWK would accept on many hosts.
if [ -x /usr/bin/mawk ]; then
	export AWK=/usr/bin/mawk
fi
case $(uname -m) in
	x86_64)
		sed -e '/m64=/s/lib64/lib/' \
			-i.orig gcc/config/i386/t-linux64
		;;
esac

mkdir -v build
cd build
../configure --prefix=/usr            \
             LD=ld                    \
             --enable-languages=c,c++ \
             --enable-default-pie     \
             --enable-default-ssp     \
             --enable-host-pie        \
             --enable-targets=all     \
             --disable-multilib       \
             --disable-bootstrap      \
             --disable-fixincludes    \
             --with-system-zlib
make
make DESTDIR="$ZPKG_DESTROOT" install

ln -sv /usr/bin/cpp "$ZPKG_DESTROOT/usr/lib/cpp"
lto=$(find "$ZPKG_DESTROOT/usr/libexec" -name liblto_plugin.so | head -n1)
mkdir -p "$ZPKG_DESTROOT/usr/lib/bfd-plugins"
ln -sfvr "$lto" "$ZPKG_DESTROOT/usr/lib/bfd-plugins/liblto_plugin.so"
