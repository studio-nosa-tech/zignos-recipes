#!/bin/sh
# locales — /etc/locale.gen, locale-gen and the default locale.conf.
# The actual locale data is generated by post_install (localedef), so it is
# not part of the package manifest and can be regenerated at any time.
set -e

D="$ZPKG_DESTROOT"
install -vDm644 "$ZPKG_RECIPE_DIR/etc/locale.gen" "$D/etc/locale.gen"
install -vDm644 "$ZPKG_RECIPE_DIR/etc/locale.conf" "$D/etc/locale.conf"
install -vDm755 "$ZPKG_RECIPE_DIR/sbin/locale-gen" "$D/usr/sbin/locale-gen"
