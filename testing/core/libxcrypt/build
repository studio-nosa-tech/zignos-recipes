#!/bin/sh
# libxcrypt — password hashing library (LFS 13.1-systemd 8.29, tests
# skipped in v0). Required by shadow's yescrypt passwords.
set -e

cd "$ZPKG_SRC/libxcrypt-4.5.2"
# glibc-2.43+ header fix from the book.
sed -i '/strchr/s/const//' lib/crypt-sm3-yescrypt.c lib/crypt-gost-yescrypt.c
./configure --prefix=/usr                \
            --enable-hashes=strong,glibc \
            --enable-obsolete-api=no     \
            --disable-static             \
            --disable-failure-tokens
make -j"$(nproc)"
make DESTDIR="$ZPKG_DESTROOT" install
