#!/bin/sh
# SPIRV-LLVM-Translator — LLVMSPIRVLib, used by Mesa's CLC to compile
# OpenCL C (BLORP/Intel shaders) to SPIR-V. Built against the LLVM 23.1
# toolchain in /usr/lib/llvm-23.
set -e

export PATH="/usr/lib/llvm-23/bin:$PATH"
export LD_LIBRARY_PATH="/usr/lib/llvm-23/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# SPIRV-Headers must match v23.1.3's spirv-headers-tag.conf (cb42dec…).
# The 2026.4 headers lack OpSubgroupBitcastShuffleINTEL, which the
# translator's generated SPIRVOpCodeEnum.h references.
cd "$ZPKG_SRC/SPIRV-LLVM-Translator-23.1.3"
cmake -S . -B build -G Ninja \
	-DCMAKE_INSTALL_PREFIX=/usr \
	-DCMAKE_INSTALL_LIBDIR=lib \
	-DCMAKE_BUILD_TYPE=Release \
	-DBUILD_SHARED_LIBS=ON \
	-DLLVM_DIR=/usr/lib/llvm-23/lib/cmake/llvm \
	-DLLVM_SPIRV_BUILD_EXTERNAL=YES \
	-DLLVM_SPIRV_INCLUDE_TESTS=OFF \
	-DLLVM_EXTERNAL_SPIRV_HEADERS_SOURCE_DIR="$ZPKG_SRC/SPIRV-Headers-cb42dec3830d3ac67fa449ecdc0c0f73d5e74498"
cmake --build build
DESTDIR="$ZPKG_DESTROOT" cmake --install build
