#!/bin/sh
# libepoxy - OpenGL/EGL/GLX function loader. GTK3's X11 backend includes
# epoxy/glx.h, so GLX and X11 must be enabled.
set -e

cd "$ZPKG_SRC/libepoxy-1.5.10"
meson setup build --prefix=/usr --libdir=lib --buildtype=release \
	-Dx11=true \
	-Dglx=yes \
	-Degl=yes \
	-Dtests=false \
	-Ddocs=false
ninja -C build
DESTDIR="$ZPKG_DESTROOT" meson install -C build
