#!/bin/sh
# Qt Shader Tools — qsb and the runtime shader library used by Qt Quick.
# This module is CMake-only (no top-level configure wrapper).
set -e

cd "$ZPKG_SRC/qtshadertools-everywhere-src-$ZPKG_VERSION"
cmake -S . -B build -G Ninja \
	-DCMAKE_INSTALL_PREFIX=/usr \
	-DCMAKE_INSTALL_LIBDIR=lib \
	-DCMAKE_BUILD_TYPE=Release \
	-DQT_BUILD_TESTS=OFF \
	-DQT_BUILD_EXAMPLES=OFF
cmake --build build
DESTDIR="$ZPKG_DESTROOT" cmake --install build
