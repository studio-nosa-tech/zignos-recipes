#!/bin/sh
# pyparsing — Python parsing helpers; Flatpak's meson build imports it.
set -e

cd "$ZPKG_SRC/pyparsing-$ZPKG_VERSION"
purelib=$(python3 -c 'import sysconfig; print(sysconfig.get_path("purelib"))')
install -d "$ZPKG_DESTROOT$purelib"
cp -a pyparsing "$ZPKG_DESTROOT$purelib/"
install -Dm644 LICENSE "$ZPKG_DESTROOT/usr/share/licenses/pyparsing/LICENSE"
