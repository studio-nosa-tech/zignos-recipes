#!/bin/sh
# fcitx5-configtool — Qt/KCM configuration UI for fcitx5.
set -e

cd "$ZPKG_SRC/fcitx5-configtool-5.1.16"
cmake -S . -B build -G Ninja 	-DCMAKE_INSTALL_PREFIX=/usr 	-DCMAKE_INSTALL_LIBDIR=lib 	-DCMAKE_BUILD_TYPE=Release 	-DENABLE_KCM=ON 	-DENABLE_CONFIG_QT=ON 	-DENABLE_TEST=OFF
cmake --build build
DESTDIR="$ZPKG_DESTROOT" cmake --install build
