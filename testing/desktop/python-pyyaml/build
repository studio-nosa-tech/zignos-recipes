#!/bin/sh
# PyYAML — Mesa imports the pure-Python yaml module at build time.
# The optional libyaml C extension is not built.
set -e

cd "$ZPKG_SRC/pyyaml-6.0.3"
purelib=$(python3 -c 'import sysconfig; print(sysconfig.get_path("purelib"))')
install -d "$ZPKG_DESTROOT$purelib"
cp -a lib/yaml "$ZPKG_DESTROOT$purelib/"
install -Dm644 LICENSE "$ZPKG_DESTROOT/usr/share/licenses/pyyaml/LICENSE"
