#!/bin/sh
# Gwenview — KDE image viewer (KDE Gear 25.04.3). Optional Baloo,
# KActivities, KDCRAW, CFitsio and TIFF integrations are auto-detected;
# the required chain is Qt6 + KF6, Phonon, Exiv2, LCMS2 and
# kImageAnnotator/kColorPicker.
set -e

cd "$ZPKG_SRC/gwenview-$ZPKG_VERSION"
cmake -S . -B build -G Ninja \
	-DCMAKE_INSTALL_PREFIX=/usr \
	-DCMAKE_INSTALL_LIBDIR=lib \
	-DCMAKE_BUILD_TYPE=Release \
	-DBUILD_TESTING=OFF
cmake --build build
DESTDIR="$ZPKG_DESTROOT" cmake --install build
