#!/bin/sh
# Union — QtQuick/Kirigami style engine (Plasma 6.8.3).
# The optional CSS and PlasmaSVG input plugins are disabled: the style KCM
# in plasma-workspace only links Union::Union, so the Rust CSS parser and
# ryml dependencies stay out of the tree.
set -e

cd "$ZPKG_SRC/union-$ZPKG_VERSION"
cmake -S . -B build -G Ninja \
	-DCMAKE_INSTALL_PREFIX=/usr \
	-DCMAKE_INSTALL_LIBDIR=lib \
	-DCMAKE_BUILD_TYPE=Release \
	-DBUILD_TESTING=OFF \
	-DBUILD_EXAMPLES=OFF \
	-DBUILD_INPUT_CSS=OFF \
	-DBUILD_INPUT_PLASMASVG=OFF
cmake --build build
DESTDIR="$ZPKG_DESTROOT" cmake --install build
