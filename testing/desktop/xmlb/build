#!/bin/sh
# xmlb — binary XML library used by AppStream.
set -e

cd "$ZPKG_SRC/libxmlb-$ZPKG_VERSION"
rm -rf build
meson setup build --prefix=/usr --libdir=lib --buildtype=release \
	-Dgtkdoc=false -Dintrospection=false -Dtests=false -Dstemmer=false \
	-Dcli=true -Dlzma=enabled -Dzstd=enabled
ninja -C build
DESTDIR="$ZPKG_DESTROOT" meson install -C build --no-rebuild
