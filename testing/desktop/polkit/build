#!/bin/sh
# polkit — authorization framework. Uses elogind for session tracking,
# PAM for authentication, and duktape for JavaScript rules.
set -e

cd "$ZPKG_SRC/polkit-128"
meson setup build 	--prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var 	--buildtype=release 	-Dsession_tracking=elogind -Dauthfw=pam 	-Dintrospection=false -Dman=false -Dtests=false -Dexamples=false 	-Dgettext=false -Dos_type=gentoo -Dprivileged_group=wheel 	-Dpam_prefix=/etc/pam.d -Dpam_module_dir=/usr/lib/security 	-Dsystemdsystemunitdir=/usr/lib/systemd/system
ninja -C build
DESTDIR="$ZPKG_DESTROOT" meson install -C build
