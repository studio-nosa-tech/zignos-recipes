#!/bin/sh
# KDE Frameworks 6 module. Multimedia scanner support is required by
# Spectacle 6.8's barcode/QR scanning integration.
set -e

cd "$ZPKG_SRC/prison-$ZPKG_VERSION"
cmake -S . -B build -G Ninja \
	-DCMAKE_INSTALL_PREFIX=/usr \
	-DCMAKE_INSTALL_LIBDIR=lib \
	-DCMAKE_BUILD_TYPE=Release \
	-DWITH_DMTX=OFF \
	-DWITH_ZXING=ON \
	-DBUILD_TESTING=OFF \
	-DBUILD_HTML_DOCS=OFF \
	-DBUILD_MAN_DOCS=OFF \
	-DBUILD_PYTHON_BINDINGS=OFF \
	-DWITH_MULTIMEDIA=ON \
	-DBUILD_QTHELP_DOCS=OFF
cmake --build build
DESTDIR="$ZPKG_DESTROOT" cmake --install build
