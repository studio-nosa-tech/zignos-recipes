#!/bin/sh
# GdkPixbuf — image loading for the fcitx5 classic UI.
set -e

cd "$ZPKG_SRC/gdk-pixbuf-2.44.8"
# Upstream turns glycin from auto into enabled on Linux. It is a heavy Rust
# image loader; the fcitx5 classic UI only needs the png/jpeg loaders.
meson setup build --prefix=/usr --libdir=lib --buildtype=release 	-Dpng=enabled -Djpeg=enabled -Dtiff=disabled -Dgif=enabled -Dglycin=disabled 	-Dintrospection=disabled -Dman=false -Dtests=false 	-Dinstalled_tests=false -Dgtk_doc=false -Ddocumentation=false
ninja -C build
DESTDIR="$ZPKG_DESTROOT" meson install -C build
