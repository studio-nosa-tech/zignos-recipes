#!/bin/sh
# libglvnd — vendor-neutral OpenGL/EGL dispatch. X11/GLX are enabled so
# Xwayland and X11 applications get the real libGL/libGLX entry points;
# Mesa provides the GLX vendor library for the software/virtio drivers.
set -e

cd "$ZPKG_SRC/libglvnd-1.7.0"
meson setup build --prefix=/usr --libdir=lib --buildtype=release \
	-Dx11=enabled \
	-Dglx=enabled \
	-Dhgl=false \
	-Degl=true \
	-Dgles1=false \
	-Dgles2=true
ninja -C build
DESTDIR="$ZPKG_DESTROOT" meson install -C build
