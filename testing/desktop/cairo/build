#!/bin/sh
# cairo — 2D graphics for Pango, GTK3 and the fcitx5 classic UI. GTK3's
# X11 backend needs the cairo-xlib surface, and XCB is cheap to include.
set -e

cd "$ZPKG_SRC/cairo-1.18.6"
meson setup build --prefix=/usr --libdir=lib --buildtype=release \
	-Dxlib=enabled -Dxcb=enabled \
	-Dglib=enabled -Dpng=enabled -Dfreetype=enabled -Dfontconfig=enabled \
	-Dlzo=disabled -Dspectre=disabled -Dgtk2-utils=disabled \
	-Dtests=disabled -Dsymbol-lookup=disabled
ninja -C build
DESTDIR="$ZPKG_DESTROOT" meson install -C build
