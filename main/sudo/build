#!/bin/sh
# sudo — the de-facto standard privilege escalation tool (portable
# 1.9.17p2). ZIGNOS ships doas in the default image; sudo lives in main/
# for people who expect sudo. There is no PAM here, so sudo authenticates
# against /etc/shadow (configure's default without --with-pam).
set -e

cd "$ZPKG_SRC/sudo-1.9.17p2"
# No OpenSSL: 1.9.17p2's hostcheck.c still pokes at ASN1_STRING internals,
# which OpenSSL 4 made opaque. sudo only needs OpenSSL for TLS/logsrvd, so
# build without the log client/server and use sudo's bundled SHA-2.
./configure --prefix=/usr                     \
            --libexecdir=/usr/lib             \
            --disable-log-client              \
            --disable-log-server              \
            --with-secure-path                \
            --with-all-insults                \
            --with-env-editor                 \
            --docdir=/usr/share/doc/sudo-1.9.17p2 \
            --with-passprompt="[sudo] password for %p: "
make -j"$(nproc)"
make DESTDIR="$ZPKG_DESTROOT" install

# Replace upstream's default policy with ZIGNOS's: wheel may run anything.
install -Dm440 "$ZPKG_RECIPE_DIR/sudoers" "$ZPKG_DESTROOT/etc/sudoers"
