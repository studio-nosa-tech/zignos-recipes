#!/bin/sh
# age — simple, modern file encryption (Go). Binaries are built from
# source and the pre-generated man pages from doc/ are installed.
set -e

cd "$ZPKG_SRC/age-1.3.2"
export GOPATH="$ZPKG_WORKDIR/go"
export GOCACHE="$ZPKG_WORKDIR/gocache"
go build -trimpath -ldflags "-X main.Version=v1.3.2" -o age ./cmd/age
go build -trimpath -ldflags "-X main.Version=v1.3.2" -o age-keygen ./cmd/age-keygen

install -Dm755 age "$ZPKG_DESTROOT/usr/bin/age"
install -Dm755 age-keygen "$ZPKG_DESTROOT/usr/bin/age-keygen"
for m in age.1 age-keygen.1 age-inspect.1 age-plugin-batchpass.1; do
	[ -f "doc/$m" ] && install -Dm644 "doc/$m" "$ZPKG_DESTROOT/usr/share/man/man1/$m"
done
