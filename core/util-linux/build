#!/bin/sh
# util-linux — misc system utilities (LFS 13.1-systemd 8.81, built without
# systemd; login/su stay disabled until a shadow recipe exists).
set -e

cd "$ZPKG_SRC/util-linux-2.42.2"
./configure --bindir=/usr/bin     \
            --libdir=/usr/lib     \
            --runstatedir=/run    \
            --sbindir=/usr/sbin   \
            --disable-chfn-chsh   \
            --disable-login       \
            --disable-nologin     \
            --disable-su          \
            --disable-setpriv     \
            --disable-runuser     \
            --disable-pylibmount  \
            --disable-static      \
            --disable-liblastlog2 \
            --without-python      \
            --without-systemd     \
            ADJTIME_PATH=/var/lib/hwclock/adjtime \
            --docdir=/usr/share/doc/util-linux-2.42.2
make -j"$(nproc)"
make DESTDIR="$ZPKG_DESTROOT" install
