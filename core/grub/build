#!/bin/sh
# grub — the bootloader, BIOS (i386-pc) and UEFI (x86_64-efi).
# GRUB's configure builds one target/platform pair at a time, so this recipe
# configures two build trees and installs both module sets into
# /usr/lib/grub/{i386-pc,x86_64-efi}. Tests are skipped.
set -e

cd "$ZPKG_SRC/grub-2.14"
unset CFLAGS CPPFLAGS CXXFLAGS LDFLAGS
# grub-2.14 configure passes an option recent binutils reject.
sed 's/--image-base/--nonexist-linker-option/' -i configure

build_target() {
	target=$1 platform=$2
	mkdir -p "build-$target-$platform"
	(
		cd "build-$target-$platform"
		../configure --prefix=/usr          \
			--sysconfdir=/etc           \
			--target="$target"          \
			--with-platform="$platform" \
			--disable-efiemu            \
			--disable-werror
		make -j"$(nproc)"
		make DESTDIR="$ZPKG_DESTROOT" install
	)
}

build_target i386 pc
build_target x86_64 efi
