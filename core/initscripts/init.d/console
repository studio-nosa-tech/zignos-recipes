#!/bin/sh
# ZIGNOS: serial console on ttyS0, auto-logged in as root for now.
# supervise-daemon runs agetty in foreground mode; agetty opens the port
# itself and dups it onto fd 0/1/2, so the shell talks to the serial line.

description="serial console on ttyS0"

supervisor=supervise-daemon
command=/usr/sbin/agetty
command_args_foreground="-n -l /bin/bash ttyS0 115200 vt100"

depend() {
	after localmount
}
