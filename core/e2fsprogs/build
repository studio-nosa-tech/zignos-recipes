#!/bin/sh
# e2fsprogs — ext2/3/4 filesystem tools (LFS 13.1-systemd 8.82, tests
# skipped in v0). Uses util-linux's blkid/uuid (see depends).
set -e

cd "$ZPKG_SRC/e2fsprogs-1.47.4"
mkdir -v build
cd build
../configure --prefix=/usr       \
             --sysconfdir=/etc   \
             --enable-elf-shlibs \
             --disable-libblkid  \
             --disable-libuuid   \
             --disable-uuidd     \
             --disable-fsck
make -j"$(nproc)"
make DESTDIR="$ZPKG_DESTROOT" install
# The fsck front-end is util-linux's; expose the e2fsck backends to it.
for t in ext2 ext3 ext4; do
	ln -sv e2fsck "$ZPKG_DESTROOT/usr/sbin/fsck.$t"
done
for lib in com_err e2p ext2fs ss; do
	rm -fv "$ZPKG_DESTROOT/usr/lib/lib$lib.a"
done
