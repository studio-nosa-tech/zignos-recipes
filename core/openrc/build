#!/bin/sh
# openrc — the init system (OpenRC 0.64.1; the GitHub tag has no release
# object, so the source is the tag archive tarball). 0.64 builds with
# meson; the tarball comes from the zpkg source cache like pkgconf does.
set -e

cd "$ZPKG_SRC/openrc-0.64.1"
tar -xf "$ZPKG_CACHE/meson-1.12.0.tar.gz"
mkdir -v build
cd build
python3 ../meson-1.12.0/meson.py setup \
	--prefix=/usr --buildtype=release \
	-Dpam=false \
	-Duucp_group=root \
	..
ninja
DESTDIR="$ZPKG_DESTROOT" ninja install
