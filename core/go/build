#!/bin/sh
# go — the Go toolchain; needed to build zpkg itself (self-hosting).
# TODO(M2): Go 1.20+ can be built with only a C compiler; verify the exact
# bootstrap invocation for the pinned version and set GOROOT_BOOTSTRAP or
# the C-only bootstrap path accordingly.
set -e

cd "$ZPKG_SRC/go/src"
./make.bash

mkdir -p "$ZPKG_DESTROOT/usr/local"
cp -a "$ZPKG_SRC/go" "$ZPKG_DESTROOT/usr/local/go"
