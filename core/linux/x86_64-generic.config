# ZIGNOS generic x86_64 fragment.
#
# Merged over the kernel's x86_64_defconfig: defconfig supplies the broad
# desktop/server driver base, this fragment pins the boot-critical pieces to
# =y (so the initramfs does not need modules) and enables extra hardware as
# modules. Users are expected to tweak this file for their own machines.
#
# Boot path: UEFI/BIOS -> GRUB -> vmlinuz + initramfs.img -> root=UUID ->
# OpenRC. The initramfs is busybox-only; storage, USB and console drivers
# must therefore be built in, not modular.

# --- initramfs -------------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# --- platform --------------------------------------------------------------
CONFIG_ACPI=y
CONFIG_X86_LOCAL_APIC=y
CONFIG_X86_IO_APIC=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_HPET_TIMER=y

# --- storage (boot-critical, built in) -------------------------------------
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_VIRTIO_BLK=y

# --- USB / input (built in so a USB keyboard works at the console) ---------
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO_I8042=y

# --- console: serial + VGA text + UEFI GOP framebuffer ---------------------
# simpledrm/fbcon give a working console on UEFI machines before any native
# GPU driver loads (the firmware's GOP framebuffer is used).
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_EFI=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y

# --- filesystems -----------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_ISO9660_FS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_LOOP=y

# --- networking (virtual + common wired, built in) -------------------------
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NET_CORE=y
CONFIG_PACKET=y
CONFIG_VIRTIO_NET=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_R8169=y

# --- modules ---------------------------------------------------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_COMPRESS_NONE=y
# CONFIG_MODULE_SIG is not set
# CONFIG_WERROR is not set
CONFIG_DEBUG_INFO_NONE=y

# --- extra hardware as modules (loaded after the root fs is up) ------------
# storage controllers
CONFIG_MEGARAID_SAS=m
CONFIG_MPT3SAS=m
# wired NICs
CONFIG_IXGBE=m
CONFIG_IXGBEVF=m
CONFIG_TIGON3=m
CONFIG_BNX2=m
CONFIG_FORCEDETH=m
CONFIG_8139TOO=m
CONFIG_NE2K_PCI=m
CONFIG_VMXNET3=m
CONFIG_HYPERV_NET=m
CONFIG_USB_RTL8152=m
# filesystems
CONFIG_SQUASHFS=m
CONFIG_XFS_FS=m
CONFIG_BTRFS_FS=m
CONFIG_NTFS3_FS=m
CONFIG_FUSE_FS=m
CONFIG_OVERLAY_FS=m
# GPUs (simpledrm already provides a console before these load)
CONFIG_DRM_I915=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_RADEON=m
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_DRM_QXL=m
CONFIG_DRM_BOCHS=m
# WiFi (firmware comes from main/linux-firmware)
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLDVM=m
CONFIG_ATH9K=m
CONFIG_ATH10K=m
CONFIG_ATH11K=m
CONFIG_ATH12K=m
CONFIG_RTW88=m
CONFIG_RTW89=m
CONFIG_RTL8XXXU=m
CONFIG_MT7601U=m
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m
CONFIG_MT7921E=m
CONFIG_MT7921U=m
CONFIG_BRCMFMAC=m
# Bluetooth and USB-serial
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_OPTION=m

# --- misc ------------------------------------------------------------------
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BINFMT_MISC=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_INTF_DEV=y
