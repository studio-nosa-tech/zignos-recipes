# ZIGNOS minimal kernel for the QEMU x86_64 boot test (M3).
# Merged over allnoconfig: everything is off unless listed here.
# Device access is virtio (QEMU -drive if=virtio), console is serial,
# root filesystem is ext4, devtmpfs is auto-mounted.

CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_LEGACY_PTYS=y
CONFIG_LEGACY_PTY_COUNT=2

# serial console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# device management
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# QEMU pc machine
CONFIG_PCI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y

# Block devices menu gate: without BLK_DEV=y allnoconfig hides
# virtio_blk and the root device never appears.
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y

# root filesystem
CONFIG_EXT4_FS=y
CONFIG_FS_POSIX_ACL=y

# process/environment basics
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y

# avoid objtool/libelf (the ORC unwinder requires it)
CONFIG_UNWINDER_FRAME_POINTER=y

# no initramfs: direct root= mount
# CONFIG_BLK_DEV_INITRD is not set
# CONFIG_MODULES is not set
