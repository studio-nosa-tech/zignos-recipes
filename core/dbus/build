#!/bin/sh
# dbus — system message bus. The messagebus account comes from initscripts;
# the machine-id is generated by the dbus service on first boot.
set -e

cd "$ZPKG_SRC/dbus-$ZPKG_VERSION"
./configure --prefix=/usr                        \
            --sysconfdir=/etc                    \
            --localstatedir=/var                 \
            --runstatedir=/run                   \
            --disable-static                     \
            --disable-systemd                    \
            --disable-tests                      \
            --disable-embedded-tests             \
            --disable-modular-tests              \
            --without-x                          \
            --with-dbus-user=messagebus
make -j"$(nproc)"
make DESTDIR="$ZPKG_DESTROOT" install
install -d "$ZPKG_DESTROOT/var/lib/dbus"
